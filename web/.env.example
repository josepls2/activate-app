# Nada de esto es obligatorio: la configuración pública de Firebase ya va en
# src/lib/firebase.ts. Úsalo sólo para probar en local con otros valores.
# En GitHub, las claves opcionales se ponen como *Variables* del repositorio.

# Notificaciones push: Firebase Console → Configuración del proyecto →
# Cloud Messaging → Certificados push web → «Generar par de claves».
VITE_FCM_VAPID_KEY=

# App Check con reCAPTCHA Enterprise.
VITE_APPCHECK_SITE_KEY=

# Sobrescribir la configuración de Firebase (normalmente vacío).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
