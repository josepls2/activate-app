{
  "name": "activate-web",
  "version": "0.1.0",
  "private": true,
  "description": "Web app de Activate Personal Training (port de la app iOS) para todos los roles.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc -b",
    "test:rules": "node --test tests/*.test.mjs",
    "build:demo": "vite build --config vite.demo.config.ts"
  },
  "dependencies": {
    "firebase": "^12.3.0",
    "lucide-react": "^1.51.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
